// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// PATIENT MANAGEMENT
// ============================================

model Patient {
  id            String         @id @default(cuid())
  mrn           String         @unique
  nric          String         @unique
  name          String
  dob           DateTime
  gender        String
  phone         String?
  email         String?
  address       String?
  allergies     String[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  // Patient Portal Authentication Fields
  passwordHash       String?  // For password-based login
  pinHash            String?  // For simple 6-digit PIN login
  isPortalActive     Boolean  @default(false)
  portalActivatedAt  DateTime?
  lastPortalLogin    DateTime?
  portalLanguage     String   @default("en") // 'en' or 'ms'
  
  prescriptions Prescription[]
  appointments  Appointment[]
  adrIncidents  AdrIncident[]
  portalAccessLogs PatientPortalAccess[]
  sharedRecords    PatientSharedRecord[]
  
  @@index([mrn])
  @@index([nric])
  @@index([name])
  @@map("patients")
}

// ============================================
// MEDICATION MANAGEMENT
// ============================================

model Medication {
  code              String   @id
  nameFull          String
  genericName       String
  strength          String?
  form              String
  route             String?
  isControlled      Boolean  @default(false)
  requiresColdChain Boolean  @default(false)
  stockLevel        Int      @default(0)
  reorderLevel      Int      @default(0)
  unitPrice         Decimal  @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  prescriptionItems PrescriptionItem[]
  ddRegisters       DdRegister[]
  adrIncidents      AdrIncident[]
  
  @@index([genericName])
  @@index([isControlled])
  @@index([requiresColdChain])
  @@map("medications")
}

// ============================================
// PRESCRIPTION MANAGEMENT
// ============================================

model Prescription {
  id                String             @id @default(cuid())
  patientId         String
  source            String             // 'Outpatient', 'Ward', 'Emergency'
  status            String             // 'new', 'screening', 'verified', 'dispensing', 'ready', 'collected', 'cancelled'
  prescribedBy      String
  prescribedAt      DateTime
  verifiedBy        String?
  verifiedAt        DateTime?
  dispensedBy       String?
  dispensedAt       DateTime?
  collectedBy       String?
  collectedAt       DateTime?
  notes             String?
  priority          String?            // 'normal', 'urgent', 'stat'
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  
  patient           Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  items             PrescriptionItem[]
  ddRegisters       DdRegister[]
  
  @@index([patientId])
  @@index([status])
  @@index([prescribedAt])
  @@index([source])
  @@map("prescriptions")
}

model PrescriptionItem {
  id              String        @id @default(cuid())
  prescriptionId  String
  drugCode        String
  quantity        Int
  dosage          String
  frequency       String
  duration        String?
  instructions    String?
  createdAt       DateTime      @default(now())
  
  prescription    Prescription  @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medication      Medication    @relation(fields: [drugCode], references: [code])
  
  @@index([prescriptionId])
  @@index([drugCode])
  @@map("prescription_items")
}

// ============================================
// APPOINTMENT MANAGEMENT
// ============================================

model Appointment {
  id          String   @id @default(cuid())
  patientId   String
  dateTime    DateTime
  type        String   // 'Counseling', 'MTAC', 'Follow-up'
  status      String   // 'scheduled', 'completed', 'cancelled', 'no-show'
  pharmacist  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  @@index([patientId])
  @@index([dateTime])
  @@index([status])
  @@index([type])
  @@map("appointments")
}

// ============================================
// FACILITY MANAGEMENT
// ============================================

model Facility {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  type        String   // 'Hospital', 'Clinic', 'Health Centre'
  state       String
  district    String?
  address     String?
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([state])
  @@index([type])
  @@index([code])
  @@map("facilities")
}

// ============================================
// DRUG SAFETY
// ============================================

model DrugInteraction {
  id          String   @id @default(cuid())
  drug1Code   String
  drug2Code   String
  severity    String   // 'minor', 'moderate', 'major'
  description String
  management  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([drug1Code, drug2Code])
  @@index([drug1Code])
  @@index([drug2Code])
  @@index([severity])
  @@map("drug_interactions")
}

model AdrIncident {
  id              String   @id @default(cuid())
  patientId       String
  medicationCode  String
  reaction        String
  severity        String   // 'mild', 'moderate', 'severe'
  onset           DateTime
  reportedBy      String
  reportedAt      DateTime @default(now())
  status          String   // 'reported', 'investigating', 'resolved'
  notes           String?
  updatedAt       DateTime @updatedAt
  
  patient         Patient     @relation(fields: [patientId], references: [id])
  medication      Medication  @relation(fields: [medicationCode], references: [code])
  
  @@index([patientId])
  @@index([medicationCode])
  @@index([severity])
  @@index([status])
  @@map("adr_incidents")
}

// ============================================
// DANGEROUS DRUG REGISTER
// ============================================

model DdRegister {
  id              String        @id @default(cuid())
  medicationCode  String
  batchNumber     String
  transactionType String        // 'received', 'dispensed', 'destroyed', 'adjustment'
  quantity        Int
  balance         Int
  prescriptionId  String?
  performedBy     String
  witnessedBy     String?
  timestamp       DateTime      @default(now())
  notes           String?
  
  medication      Medication    @relation(fields: [medicationCode], references: [code])
  prescription    Prescription? @relation(fields: [prescriptionId], references: [id])
  
  @@index([medicationCode])
  @@index([timestamp])
  @@index([transactionType])
  @@map("dd_registers")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String   // Hashed with bcrypt
  name        String
  email       String   @unique
  department  String
  role        String   // 'pharmacist', 'technician', 'admin', 'doctor', 'nurse'
  isActive    Boolean  @default(true)
  lastLogin   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([username])
  @@index([department])
  @@index([role])
  @@map("users")
}

// ============================================
// AUDIT LOGS
// ============================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  action      String   // 'CREATE', 'UPDATE', 'DELETE', 'VIEW'
  entity      String   // 'Prescription', 'Patient', 'Medication'
  entityId    String
  changes     Json?    // Store what changed
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime @default(now())
  
  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([timestamp])
  @@map("audit_logs")
}

// ============================================
// ADMINISTRATOR MANAGEMENT
// ============================================

model SystemAlert {
  id          String   @id @default(cuid())
  type        String   // 'security', 'performance', 'maintenance', 'backup', 'error'
  severity    String   // 'low', 'medium', 'high', 'critical'
  department  String?
  title       String
  message     String
  status      String   // 'new', 'acknowledged', 'resolved'
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([status])
  @@index([severity])
  @@index([type])
  @@index([createdAt])
  @@map("system_alerts")
}

model DepartmentStatus {
  id                String   @id @default(cuid())
  departmentName    String   @unique
  status            String   // 'active', 'idle', 'maintenance', 'offline'
  activeUsers       Int      @default(0)
  todayTransactions Int      @default(0)
  performance       Int      @default(100) // percentage
  alerts            Int      @default(0)
  lastActivity      DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([departmentName])
  @@index([status])
  @@map("department_statuses")
}

model BackupHistory {
  id          String   @id @default(cuid())
  type        String   // 'full', 'incremental', 'differential'
  status      String   // 'completed', 'failed', 'in-progress', 'scheduled'
  sizeGB      Float
  duration    String?
  location    String
  startedAt   DateTime @default(now())
  completedAt DateTime?
  error       String?
  
  @@index([status])
  @@index([startedAt])
  @@map("backup_history")
}

model SystemConfiguration {
  id          String   @id @default(cuid())
  category    String
  key         String   @unique
  value       String
  description String
  type        String   // 'string', 'number', 'boolean', 'select'
  options     String[] // For select type
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  
  @@index([category])
  @@index([key])
  @@map("system_configurations")
}

model IntegrationStatus {
  id           String   @id @default(cuid())
  name         String   @unique
  type         String   // 'api', 'database', 'service', 'external'
  endpoint     String
  status       String   // 'connected', 'disconnected', 'error', 'maintenance'
  responseTime Int      @default(0) // in milliseconds
  lastSync     DateTime @default(now())
  errorMessage String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([name])
  @@index([status])
  @@map("integration_statuses")
}

model PerformanceMetric {
  id                 String   @id @default(cuid())
  timestamp          DateTime @default(now())
  cpuUsage           Float
  memoryUsage        Float
  diskUsage          Float
  networkIn          Float
  networkOut         Float
  activeConnections  Int
  requestsPerSecond  Int
  
  @@index([timestamp])
  @@map("performance_metrics")
}

model LicenseInfo {
  id           String   @id @default(cuid())
  feature      String   @unique
  status       String   // 'active', 'expired', 'trial'
  type         String   // 'essential', 'professional', 'enterprise'
  expiryDate   DateTime
  usersAllowed Int
  usersActive  Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([feature])
  @@index([status])
  @@map("license_info")
}

// ============================================
// PATIENT PORTAL
// ============================================

model PatientPortalAccess {
  id          String   @id @default(cuid())
  patientId   String
  accessType  String   // 'login', 'view_medications', 'view_labs', 'share_qr', 'download', etc.
  accessedAt  DateTime @default(now())
  ipAddress   String?
  userAgent   String?
  deviceInfo  String?
  
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  @@index([patientId])
  @@index([accessType])
  @@index([accessedAt])
  @@map("patient_portal_access")
}

model PatientSharedRecord {
  id             String    @id @default(cuid())
  patientId      String
  shareToken     String    @unique
  sharedAt       DateTime  @default(now())
  expiresAt      DateTime
  accessCount    Int       @default(0)
  lastAccessedAt DateTime?
  isActive       Boolean   @default(true)
  includedData   String[]  // ['medications', 'allergies', 'labs', 'vitals', 'visits']
  accessedBy     String?   // Optional: track who accessed it
  
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  @@index([patientId])
  @@index([shareToken])
  @@index([expiresAt])
  @@map("patient_shared_records")
}

